/* timeRangeDialog.wxss */
.dialog-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* background-color: rgba(250, 10, 10, 0.5); */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.dialog-content {
  background-color: #333;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
  color: #fff;
  width: 80%;
  max-width: 400px;
}

.dialog-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20px;
  text-align: center;
}

.time-input-container {
  margin-bottom: 20px;
}

.time-input-item {
  margin-bottom: 15px;
  display: flex;
  align-items: center;
}

.time-label {
  margin-right: 10px;
  font-size: 16px;
}

.picker {
  flex: 1;
  padding: 8px;
  background-color: #444;
  border-radius: 4px;
  font-size: 16px;
}

.dialog-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 20px;
}

.confirm-btn {
  background-color: #4CAF50;
  color: white;
  padding: 10px 20px;
  border-radius: 4px;
  font-size: 16px;
}

.cancel-btn {
  background-color: #f44336;
  color: white;
  padding: 10px 20px;
  border-radius: 4px;
  font-size: 16px;
}