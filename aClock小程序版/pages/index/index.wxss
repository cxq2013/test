/* index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #1a1a1a;
  font-family: Arial, sans-serif;
}

.clockCanvas {
  width: 100vw;
  height: 100vw;
  border: 2rpx solid #cccccc;
  border-radius: 50%;
}

.timeRange {
  width: 450rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #cccccc;
  text-align: center;
}

.timeText {
  text-decoration: underline;
}

.minutesDiff {
  margin-left: 10rpx;
}